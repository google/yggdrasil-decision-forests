// Multiplying by p directly gives the fractional index.
const float INV_STEP = 19999;

float binary_calibrate(float p) {
  const std::size_t n_deltas = 20000;
  const float pc = std::clamp(p, 0.0f, 1.0f);
  const auto pos = pc * INV_STEP;  // fractional grid index
  float integral_pos;
  const auto frac_pos = std::modf(pos, &integral_pos);
  const auto i0 = static_cast<std::size_t>(integral_pos);
  const std::size_t i1 = std::min(i0 + 1, n_deltas - 1);

  // Linear Interpolation (NOTE: using std::lerp actually increases latency).
  const auto delta = DELTAS[i0] + frac_pos * (DELTAS[i1] - DELTAS[i0]);
  return std::clamp(pc + delta, 0.0f, 1.0f);
};

struct __attribute__((packed)) Node {
  uint16_t pos = 0;
  union {
    struct __attribute__((packed)) {
      uint8_t feat;
      union {
        float thr;
        uint16_t cat;
      };
    } cond;
    struct __attribute__((packed)) {
      float val;
    } leaf;
  };
};
