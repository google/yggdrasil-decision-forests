// Multiplying by p directly gives the fractional index.
const float INV_STEP = 19999;

float binary_calibrate(float p) {
  const std::size_t n_deltas = 20000;
  const float pc = std::clamp(p, 0.0f, 1.0f);
  const auto pos = pc * INV_STEP;  // fractional grid index
  float integral_pos;
  const auto frac_pos = std::modf(pos, &integral_pos);
  const auto i0 = static_cast<std::size_t>(integral_pos);
  const std::size_t i1 = std::min(i0 + 1, n_deltas - 1);

  // Linear Interpolation (NOTE: using std::lerp actually increases latency).
  const auto delta = DELTAS[i0] + frac_pos * (DELTAS[i1] - DELTAS[i0]);
  return std::clamp(pc + delta, 0.0f, 1.0f);
};

// Predicts on an instance without any safety checks.
//
// The caller must ensure that the instance meets the following conditions:
// - Numerical features must not be NaN.
// - Integerized categorical features must be within the range [0, max_value],
//   where max_value is the maximum value observed during training.
//
// Failure to meet these conditions may result in undefined behavior.
//
// It is recommended to use `Predict()` instead, unless the instance has
// already been sanitized.
//
// This function is called by `Predict()`.
inline float PredictUnsafe(const Instance& instance) {
  float accumulator {-1.1631};

  // Tree #0
  if (instance.marital_status == FeatureMaritalStatus::kNeverMarried ||
      instance.marital_status == FeatureMaritalStatus::kDivorced ||
      instance.marital_status == FeatureMaritalStatus::kWidowed ||
      instance.marital_status == FeatureMaritalStatus::kSeparated ||
      instance.marital_status == FeatureMaritalStatus::kMarriedSpouseAbsent ||
      instance.marital_status == FeatureMaritalStatus::kMarriedAfSpouse) {
    if (instance.capital_gain >= 7669.5) {
      accumulator += 0.408065;
    } else {
      if (instance.hours_per_week >= 44.5) {
        if (instance.age >= 32.5) {
          accumulator += -0.0235444;
        } else {
          accumulator += -0.100957;
        }
      } else {
        if (instance.capital_loss >= 2218.5) {
          accumulator += 0.10903;
        } else {
          if (instance.age >= 32.5) {
            if (std::array<FeatureOccupation,11> mask = {FeatureOccupation::kCraftRepair, FeatureOccupation::kAdmClerical, FeatureOccupation::kSales, FeatureOccupation::kOtherService, FeatureOccupation::kMachineOpInspct, FeatureOccupation::kTransportMoving, FeatureOccupation::kHandlersCleaners, FeatureOccupation::kFarmingFishing, FeatureOccupation::kTechSupport, FeatureOccupation::kProtectiveServ, FeatureOccupation::kPrivHouseServ};
