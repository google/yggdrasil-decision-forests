// Prediction function.
//
// Sanitizes the given instance, then calls `PredictUnsafe()`.
inline float Predict(Instance instance) {
  instance.age = std::isnan(instance.age) ? 38.6153 : instance.age;
  instance.fnlwgt = std::isnan(instance.fnlwgt) ? 189879 : instance.fnlwgt;
  instance.capital_gain = std::isnan(instance.capital_gain) ? 1081.9 : instance.capital_gain;
  instance.capital_loss = std::isnan(instance.capital_loss) ? 87.2806 : instance.capital_loss;
  instance.hours_per_week = std::isnan(instance.hours_per_week) ? 40.3955 : instance.hours_per_week;

  return PredictUnsafe(instance);
}

