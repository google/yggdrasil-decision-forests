              std::binary_search(mask.begin(), mask.end(),  instance.education)) {
            accumulator += 0.00966253;
          } else {
            accumulator += -0.0124329;
          }
        } else {
          if (instance.hours_per_week >= 65) {
            accumulator += -0.179446;
          } else {
            accumulator += -0.0510508;
          }
        }
      } else {
        if (instance.occupation == FeatureOccupation::kMachineOpInspct ||
            instance.occupation == FeatureOccupation::kTechSupport ||
            instance.occupation == FeatureOccupation::kProtectiveServ) {
          if (instance.fnlwgt >= 350223) {
            accumulator += 0.151205;
          } else {
            accumulator += 0.028103;
          }
        } else {
          if (instance.education == FeatureEducation::kAssocAcdm ||
              instance.education == FeatureEducation::kProfSchool ||
              instance.education == FeatureEducation::k9th ||
              instance.education == FeatureEducation::kDoctorate ||
              instance.education == FeatureEducation::k5th6th) {
            accumulator += 0.0227387;
          } else {
            accumulator += -0.0174839;
          }
        }
      }
    } else {
      if (instance.marital_status == FeatureMaritalStatus::kOutOfVocabulary ||
          instance.marital_status == FeatureMaritalStatus::kNeverMarried ||
          instance.marital_status == FeatureMaritalStatus::kDivorced ||
          instance.marital_status == FeatureMaritalStatus::kWidowed ||
          instance.marital_status == FeatureMaritalStatus::kSeparated ||
          instance.marital_status == FeatureMaritalStatus::kMarriedSpouseAbsent ||
          instance.marital_status == FeatureMaritalStatus::kMarriedAfSpouse) {
        if (instance.fnlwgt >= 23723) {
          if (instance.relationship == FeatureRelationship::kOutOfVocabulary ||
              instance.relationship == FeatureRelationship::kHusband ||
              instance.relationship == FeatureRelationship::kUnmarried ||
              instance.relationship == FeatureRelationship::kWife) {
            accumulator += 0.0592346;
          } else {
            accumulator += -0.0888873;
          }
        } else {
          accumulator += 0.164704;
        }
      } else {
        if (instance.occupation == FeatureOccupation::kTransportMoving ||
            instance.occupation == FeatureOccupation::kFarmingFishing ||
            instance.occupation == FeatureOccupation::kProtectiveServ) {
          if (instance.education == FeatureEducation::kSomeCollege) {
            accumulator += 0.152413;
          } else {
            accumulator += -0.0195719;
          }
        } else {
          if (std::array<FeatureEducation,16> mask = {FeatureEducation::kOutOfVocabulary, FeatureEducation::kHsGrad, FeatureEducation::kSomeCollege, FeatureEducation::kMasters, FeatureEducation::kAssocVoc, FeatureEducation::k11th, FeatureEducation::kAssocAcdm, FeatureEducation::k10th, FeatureEducation::k7th8th, FeatureEducation::kProfSchool, FeatureEducation::k9th, FeatureEducation::k12th, FeatureEducation::kDoctorate, FeatureEducation::k5th6th, FeatureEducation::k1st4th, FeatureEducation::kPreschool};
              std::binary_search(mask.begin(), mask.end(),  instance.education)) {
            accumulator += -0.0641012;
          } else {
            accumulator += -0.133863;
          }
        }
      }
    }
  } else {
    if (instance.hours_per_week >= 49.5) {
      if (std::array<FeatureOccupation,8> mask = {FeatureOccupation::kProfSpecialty, FeatureOccupation::kExecManagerial, FeatureOccupation::kCraftRepair, FeatureOccupation::kAdmClerical, FeatureOccupation::kOtherService, FeatureOccupation::kHandlersCleaners, FeatureOccupation::kTechSupport, FeatureOccupation::kProtectiveServ};
          std::binary_search(mask.begin(), mask.end(),  instance.occupation)) {
        if (instance.fnlwgt >= 190290) {
          if (instance.education == FeatureEducation::kBachelors ||
              instance.education == FeatureEducation::kAssocAcdm ||
              instance.education == FeatureEducation::k7th8th) {
            accumulator += 0.197735;
          } else {
            accumulator += 0.0814293;
          }
        } else {
          if (instance.marital_status == FeatureMaritalStatus::kDivorced) {
            accumulator += 0.139458;
          } else {
            accumulator += -0.0406865;
          }
        }
      } else {
        if (instance.workclass == FeatureWorkclass::kSelfEmpNotInc ||
            instance.workclass == FeatureWorkclass::kStateGov ||
            instance.workclass == FeatureWorkclass::kWithoutPay) {
          if (instance.fnlwgt >= 225773) {
            accumulator += 0.188692;
          } else {
            accumulator += 0.0326668;
          }
        } else {
          if (instance.fnlwgt >= 402761) {
            accumulator += 0.125883;
          } else {
            accumulator += -0.0942004;
          }
        }
      }
    } else {
      if (instance.occupation == FeatureOccupation::kCraftRepair) {
        if (instance.age >= 52.5) {
          if (instance.education == FeatureEducation::kSomeCollege ||
              instance.education == FeatureEducation::kAssocVoc ||
              instance.education == FeatureEducation::k11th ||
              instance.education == FeatureEducation::k10th ||
              instance.education == FeatureEducation::k1st4th) {
            accumulator += 0.313582;
          } else {
            accumulator += 0.0987167;
          }
        } else {
          if (instance.workclass == FeatureWorkclass::kStateGov ||
              instance.workclass == FeatureWorkclass::kFederalGov) {
            accumulator += 0.3638;
          } else {
            accumulator += -0.0286089;
          }
        }
      } else {
        if (instance.marital_status == FeatureMaritalStatus::kOutOfVocabulary ||
            instance.marital_status == FeatureMaritalStatus::kNeverMarried ||
            instance.marital_status == FeatureMaritalStatus::kDivorced ||
            instance.marital_status == FeatureMaritalStatus::kSeparated ||
            instance.marital_status == FeatureMaritalStatus::kMarriedSpouseAbsent ||
            instance.marital_status == FeatureMaritalStatus::kMarriedAfSpouse) {
          if (std::array<FeatureNativeCountry,18> mask = {FeatureNativeCountry::kGermany, FeatureNativeCountry::kIndia, FeatureNativeCountry::kChina, FeatureNativeCountry::kItaly, FeatureNativeCountry::kVietnam, FeatureNativeCountry::kTaiwan, FeatureNativeCountry::kIran, FeatureNativeCountry::kPoland, FeatureNativeCountry::kGreece, FeatureNativeCountry::kPortugal, FeatureNativeCountry::kFrance, FeatureNativeCountry::kThailand, FeatureNativeCountry::kIreland, FeatureNativeCountry::kLaos, FeatureNativeCountry::kYugoslavia, FeatureNativeCountry::kHong, FeatureNativeCountry::kHungary, FeatureNativeCountry::kScotland};
              std::binary_search(mask.begin(), mask.end(),  instance.native_country)) {
            accumulator += 0.264338;
          } else {
            accumulator += -0.0536025;
          }
        } else {
          if (instance.fnlwgt >= 300856) {
            accumulator += -0.0745035;
          } else {
            accumulator += -0.022047;
          }
        }
      }
    }
  }

  // Sigmoid
  return binary_calibrate(1.f / (1.f + std::exp(-accumulator)));

}

}  // namespace ydf_model
#endif
