#include <cstring>
#include <stdint.h>

namespace ydf_model {

enum class FeatureType : uint32_t {
  kOutOfVocabulary = 0,
  kM = 1,
  kI = 2,
  kF = 3,
};

constexpr const int kNumFeatures = 8;
constexpr const uint8_t kNumTrees = 3;

struct Instance {
  typedef float Numerical;

  FeatureType type;
  Numerical longestshell;
  Numerical diameter;
  Numerical height;
  Numerical wholeweight;
  Numerical shuckedweight;
  Numerical visceraweight;
  Numerical shellweight;
};

// Predicts on an instance without any safety checks.
//
// The caller must ensure that the instance meets the following conditions:
// - Numerical features must not be NaN.
// - Integerized categorical features must be within the range [0, max_value],
//   where max_value is the maximum value observed during training.
//
// Failure to meet these conditions may result in undefined behavior.
//
// It is recommended to use `Predict()` instead, unless the instance has
// already been sanitized.
//
// This function is called by `Predict()`.
inline float PredictUnsafe(const Instance& instance) {
  float accumulator {9.94246};

  // Tree #0
  if (instance.shellweight >= 0.16775f) {
    if (instance.shellweight >= 0.35975f) {
      if (instance.shuckedweight >= 0.55200005f) {
        if (instance.shellweight >= 0.56875f) {
          if (instance.shuckedweight >= 0.77f) {
            accumulator += 0.312421;
          } else {
            accumulator += 0.705754;
