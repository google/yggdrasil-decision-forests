// Prediction function.
//
// Sanitizes the given instance, then calls `PredictUnsafe()`.
inline float Predict(Instance instance) {
  instance.longestshell = std::isnan(instance.longestshell) ? 0.523992 : instance.longestshell;
  instance.diameter = std::isnan(instance.diameter) ? 0.407881 : instance.diameter;
  instance.height = std::isnan(instance.height) ? 0.139516 : instance.height;
  instance.wholeweight = std::isnan(instance.wholeweight) ? 0.828742 : instance.wholeweight;
  instance.shuckedweight = std::isnan(instance.shuckedweight) ? 0.359367 : instance.shuckedweight;
  instance.visceraweight = std::isnan(instance.visceraweight) ? 0.180594 : instance.visceraweight;
  instance.shellweight = std::isnan(instance.shellweight) ? 0.238831 : instance.shellweight;

  return PredictUnsafe(instance);
}

}  // namespace ydf_model
