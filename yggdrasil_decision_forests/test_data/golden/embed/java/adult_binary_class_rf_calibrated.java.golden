    OTHER_SERVICE,
    MACHINE_OP_INSPCT,
    TRANSPORT_MOVING,
    HANDLERS_CLEANERS,
    FARMING_FISHING,
    TECH_SUPPORT,
    PROTECTIVE_SERV,
    PRIV_HOUSE_SERV,
  };

  public enum FeatureRelationship {
    OUT_OF_VOCABULARY,
    HUSBAND,
    NOT_IN_FAMILY,
    OWN_CHILD,
