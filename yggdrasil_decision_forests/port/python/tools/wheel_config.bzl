"""Repository rule exposing the configuration of the YDF pip package."""

def _ydf_wheel_config_impl(rctx):
    # The version of the package. `ydf/version.py` is the single source of
    # truth (see `tools/change_version.sh`).
    version = None
    for line in rctx.read(rctx.attr.version_file, watch = "yes").splitlines():
        if line.startswith("version = "):
            version = line[len("version = "):].strip().strip("\"")
    if not version:
        fail("Cannot find the version in %s" % rctx.attr.version_file)

    # Staging builds (e.g. for TestPyPI, where the "ydf" name is not available)
    # set a different distribution name and a version suffix, since a version
    # cannot be uploaded twice to a package index. The import name remains
    # "ydf". Same environment variables as in `config/setup.py`:
    #   YDF_PACKAGE_NAME: Distribution name, e.g. "ydf-staging". Default: "ydf".
    #   YDF_VERSION_SUFFIX: Appended to the version, e.g. ".dev202610141400".
    package_name = rctx.getenv("YDF_PACKAGE_NAME", "ydf")
    version += rctx.getenv("YDF_VERSION_SUFFIX", "")

    # The license of the package is at the root of the C++ repository, which
    # does not contain a BUILD file.
    license = rctx.path(rctx.attr.cc_repo_marker).dirname.dirname.get_child("LICENSE")
    rctx.file("LICENSE", rctx.read(license, watch = "yes"))

    rctx.file("config.bzl", "\n".join([
        "\"\"\"Configuration of the YDF pip package. Generated by ydf_wheel_config.\"\"\"",
        "",
        "PACKAGE_NAME = %s" % repr(package_name),
        "VERSION = %s" % repr(version),
        "",
    ]))
    rctx.file("BUILD.bazel", "exports_files([\"LICENSE\", \"config.bzl\"])\n")

ydf_wheel_config = repository_rule(
    implementation = _ydf_wheel_config_impl,
    doc = """Exposes the name and version of the YDF pip package in `config.bzl`.

Set the YDF_PACKAGE_NAME and YDF_VERSION_SUFFIX environment variables (or
`--repo_env`) to build a staging package.
""",
    attrs = {
        "cc_repo_marker": attr.label(
            doc = "A file in the `yggdrasil_decision_forests` directory of the C++ repository.",
            mandatory = True,
        ),
        "version_file": attr.label(
            doc = "The `version.py` file of the Python package.",
            mandatory = True,
        ),
    },
)
