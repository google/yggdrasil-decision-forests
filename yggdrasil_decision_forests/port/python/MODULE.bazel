module(
    name = "ydf",
    version = "0.17.0",
)

bazel_dep(name = "abseil-cpp", version = "20260526.0", repo_name = "com_google_absl")

# Note: abseil-py 2.4.0 registers non-hermetic `runtime_env` Python toolchains.
bazel_dep(name = "abseil-py", version = "2.1.0")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", repo_name = "com_google_googletest")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "31.1", repo_name = "com_google_protobuf")
bazel_dep(name = "pybind11_bazel", version = "3.0.3")
bazel_dep(name = "pybind11_protobuf", version = "0.0.0-20261001-ca1c3d3")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_python", version = "2.4.5")
bazel_dep(name = "yggdrasil_decision_forests", version = "1.12.0", repo_name = "ydf_cc")
local_path_override(
    module_name = "yggdrasil_decision_forests",
    path = "../../../",
)

# Hermetic C++ toolchain for Linux x86_64: LLVM (Clang) with an Ubuntu 18.04
# sysroot (glibc 2.27, libstdc++ of GCC 8). The binaries only depend on glibc
# <= 2.27, so the wheels are manylinux_2_27 compatible when built on any Linux
# host, without a manylinux Docker image. See .bazelrc for the configuration.
#
# Not on the BCR yet (except release candidates). The commit is the one used by
# JAX.
bazel_dep(name = "rules_ml_toolchain")
archive_override(
    module_name = "rules_ml_toolchain",
    integrity = "sha256-9+4rpwQMv77PxA+AGMWpwcjioakWHi4nJ7UQ0iPHrJo=",
    strip_prefix = "rules_ml_toolchain-3a4df0c8e9e51687ac4c62c793a00a27286e5e83",
    urls = ["https://github.com/google-ml-infra/rules_ml_toolchain/archive/3a4df0c8e9e51687ac4c62c793a00a27286e5e83.tar.gz"],
)

register_toolchains("@rules_ml_toolchain//cc:linux_x86_64_linux_x86_64")

# The protobuf module compiles `@com_google_protobuf//python:proto_api` (used by
# pybind11_protobuf) against `@system_python//:python_headers`, which protobuf
# maps to the Python 3.12 headers whatever the selected Python version. This
# breaks Python 3.14 (e.g. the layout of tuples changed). The patch uses the
# headers of the selected Python toolchain instead, like protobuf does at HEAD
# (https://github.com/protocolbuffers/protobuf/commit/720e5468cebb). Remove the
# patch once YDF uses a protobuf release that includes this change.
#
# The version is pinned because other modules depend on newer versions (e.g.
# rules_ml_toolchain and yggdrasil_decision_forests on 33.x), which would
# otherwise be selected. It is the version of the protoc generating the
# *_pb2.py files, i.e. the minimum version of the protobuf pip package (see
# tools/BUILD).
single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//:protobuf_hermetic_python_headers.patch"],
    version = "31.1",
)

# Abseil 20260526.0 has no `compatibility_level` (i.e. 0), while older
# versions requested by other modules (e.g. grpc, protobuf) have 1. Bazel fails
# on such a mismatch, unless the version is overridden.
single_version_override(
    module_name = "abseil-cpp",
    version = "20260526.0",
)

# Hermetic Python toolchains (python-build-standalone).
#
# Select the Python version with
#   --@rules_python//python/config_settings:python_version=3.X
#
# PYTHON_VERSIONS are the supported Python versions. The `ydf_wheel_config`
# repository (see below) exposes them to tools/BUILD (i.e. the tags and
# metadata of the wheel). When changing them, also update the defaults of
# tools/release.sh and the `requirements` lock target (see BUILD).
PYTHON_VERSIONS = [
    "3.10",
    "3.11",
    "3.12",
    "3.13",
    "3.14",
]

DEFAULT_PYTHON_VERSION = "3.12"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

[
    python.toolchain(
        is_default = python_version == DEFAULT_PYTHON_VERSION,
        python_version = python_version,
    )
    for python_version in PYTHON_VERSIONS
]

# Update the lock file with:
#   bazel run //:requirements.update
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.default(
    index_url = "https://pypi.org/simple",
)

[
    pip.parse(
        hub_name = "pypi_ydf",
        python_version = python_version,
        requirements_lock = "//:requirements_lock.txt",
    )
    for python_version in PYTHON_VERSIONS
]

use_repo(pip, "pypi_ydf")

# uv toolchain for the `lock` rule (see BUILD).
uv = use_extension(
    "@rules_python//python/uv:uv.bzl",
    "uv",
    dev_dependency = True,
)
uv.configure(version = "0.13.6")

# Use the PyPI protobuf package as the runtime of `py_proto_library`.
register_toolchains("//:python_proto_toolchain")

ydf_wheel_config = use_repo_rule("//tools:wheel_config.bzl", "ydf_wheel_config")

ydf_wheel_config(
    name = "ydf_wheel_config",
    cc_build_file = "@ydf_cc//yggdrasil_decision_forests:BUILD",
    python_versions = PYTHON_VERSIONS,
    version_file = "//ydf:version.py",
)
