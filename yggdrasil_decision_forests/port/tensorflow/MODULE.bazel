module(
    name = "ydf_tf",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "2.3.4")
bazel_dep(name = "yggdrasil_decision_forests", version = "1.12.0", repo_name = "ydf_cc")
local_path_override(
    module_name = "yggdrasil_decision_forests",
    path = "../../../",
)

# Hermetic Python toolchains (python-build-standalone), e.g. to create the
# virtual environments of the packaging scripts with
#   bazel run @rules_python//python/bin:python \
#     --@rules_python//python/config_settings:python_version=3.X -- -m venv <dir>
# The C++ op itself does not depend on Python.
PYTHON_VERSIONS = [
    "3.9",
    "3.10",
    "3.11",
    "3.12",
    "3.13",
]

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

[
    python.toolchain(
        is_default = python_version == "3.12",
        python_version = python_version,
    )
    for python_version in PYTHON_VERSIONS
]

# Must match the Abseil and Protobuf version used by the Tensorflow version you're compiling for.
# The current value is set for TF 2.21.0
bazel_dep(name = "abseil-cpp", version = "20250814.1", repo_name = "com_google_absl")
bazel_dep(name = "protobuf", version = "31.1", repo_name = "com_google_protobuf")
single_version_override(
    module_name = "protobuf",
    version = "31.1",
)

single_version_override(
    module_name = "abseil-cpp",
    version = "20250814.1",
)

tf_ext = use_extension("@ydf_cc//third_party:tf_downloader.bzl", "tf_downloaded_header_extension")
use_repo(tf_ext, "local_config_tf")
